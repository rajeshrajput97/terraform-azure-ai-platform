# Copy to terraform.tfvars and replace the subscription ID before you plan or apply.
subscription_id = "00000000-0000-0000-0000-000000000000"

name_prefix    = "aip"
environment    = "prod"
unique_suffix  = "001"
location       = "eastus"

address_space                    = ["10.20.0.0/16"]
databricks_public_subnet_prefix  = "10.20.0.0/24"
databricks_private_subnet_prefix = "10.20.1.0/24"
private_endpoint_subnet_prefix   = "10.20.2.0/24"

log_retention_days                 = 90
storage_replication_type           = "ZRS"
key_vault_purge_protection_enabled = true
key_vault_soft_delete_days         = 90
databricks_sku                     = "premium"
databricks_public_network_access_enabled = false
databricks_enable_private_endpoint       = true

chat_deployment_name      = "chat"
embedding_deployment_name = "embeddings"
